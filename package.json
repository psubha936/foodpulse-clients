{
  "name": "@subhaprakash/foodpulse-clients",
  "version": "1.0.1",
  "description": "Reusable infrastructure clients for FoodPulse Node.js services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psubha936/foodpulse-clients.git"
  },
  "bugs": {
    "url": "https://github.com/psubha936/foodpulse-clients/issues"
  },
  "homepage": "https://github.com/psubha936/foodpulse-clients#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test:logger": "npm run build && node --test test/logger.test.js",
    "test:mongodb": "npm run build && node --env-file=.env test/mongodb.integration.js",
    "test:redis": "npm run build && node --env-file=.env test/redis.integration.js",
    "test:kafka": "npm run build && node --env-file=.env test/kafka.integration.js",
    "test:websocket": "npm run build && node test/websocket.integration.js",
    "test:aws": "npm run build && node --test test/aws.test.js",
    "prepublishOnly": "npm run build && node --test test/logger.test.js test/aws.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "aws-jwt-verify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.5.0",
    "redis": "^6.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
